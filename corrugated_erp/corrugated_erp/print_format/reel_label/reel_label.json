 "font_size": 12,
 "html": "<style>\n\t.rl { width: 96mm; border: 2px solid #000; padding: 3mm; font-family: Arial, sans-serif; }\n\t.rl .no { font-size: 22px; font-weight: 700; text-align: center; letter-spacing: 1px; }\n\t.rl table { width: 100%; border-collapse: collapse; margin-top: 2mm; }\n\t.rl td { border: 1px solid #000; padding: 1.2mm 2mm; font-size: 12px; }\n\t.rl td.k { width: 32%; font-weight: 600; }\n\t.rl .big { font-size: 16px; font-weight: 700; }\n\t.rl .bc { text-align: center; margin-top: 2mm; }\n\t.print-format { padding: 4mm !important; }\n</style>\n<div class=\"rl\">\n\t<div class=\"no\">{{ doc.name }}</div>\n\t<div class=\"bc\">{{ code128_svg(doc.name, height=45) }}</div>\n\t<table>\n\t\t<tr><td class=\"k\">{{ _(\"Paper\") }}</td><td class=\"big\">{{ doc.bf | int if doc.bf else \"\" }} BF / {{ doc.gsm | int if doc.gsm else \"\" }} GSM {{ doc.shade or \"\" }}</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Deckle\") }}</td><td class=\"big\">{{ doc.deckle_mm | round(1) }} mm ({{ doc.deckle_inch }}\")</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Net Weight\") }}</td><td class=\"big\">{{ doc.original_weight | round(1) }} kg</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Item\") }}</td><td>{{ doc.item_name or doc.paper_item }}</td></tr>\n\t\t<tr><td class=\"k\">{{ _(\"Supplier\") }}</td><td>{{ doc.supplier or \"\" }} {% if doc.supplier_reel_no %}#{{ doc.supplier_reel_no }}{% endif %}</td></tr>\n\t\t{% if doc.parent_reel %}<tr><td class=\"k\">{{ _(\"Cut From\") }}</td><td>{{ doc.parent_reel }}</td></tr>{% endif %}\n\t\t<tr><td class=\"k\">{{ _(\"Received\") }}</td><td>{{ frappe.utils.formatdate(doc.received_date) if doc.received_date else \"\" }} &nbsp; {{ doc.location or \"\" }}</td></tr>\n\t</table>\n</div>\n",
